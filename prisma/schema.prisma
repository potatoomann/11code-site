generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String      @id @default(cuid())
  productNumber String?
  name          String
  price         Float
  description   String
  image         String
  category      String
  team          String
  stock         Int         @default(0)
  sizes         String?
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  customer  String?
  total     Float
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String
  name             String?
  phone            String?
  address          String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemEvent {
  id        String   @id @default(cuid())
  type      String
  message   String
  metadata  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
